# =============================================================================
# Project 2 — Browser Agent
#
# Note what is NOT here: no MONGO_URI, no ELEAD_CRED_KEY, no CRM password.
# This project cannot reach the database by design. Everything it needs comes
# from the job payload the dispatcher puts in Redis.
# =============================================================================

# ── The only two values the instance actually needs at launch ───────────────
# JOB_ID is injected per-instance by the dispatcher via EC2 user-data.
# JOB_ID=6a452e13-a1b2c3d4
REDIS_URL=redis://127.0.0.1:6379

# Redis streams (must match Project 3)
QUEUE_STREAM=gameplan:writes
SESSION_STREAM=gameplan:sessions
EVENT_STREAM=gameplan:events
QUEUE_MAXLEN=500000

# ── Auth ────────────────────────────────────────────────────────────────────
# Used only to mint the per-store token the scraper sends to the backend for
# READ endpoints (pending rechecks, flow config). Writes go through Redis.
# Must match the backends' secret.
JWT_SECRET=
JWT_ACCESS_EXPIRE_MINUTES=720

# ── Targets ─────────────────────────────────────────────────────────────────
CRM_HOST=crm.connectcdk.com
TARGET_URL=https://app-unify.app.connectcdk.com/applications
GAMEPLAN_API=https://gameplanagent.gameplanauto.com
SCRAPER_API=https://scraper.gameplanauto.com

# Set only if SSO auto-discovery fails (see CONTRACT.md).
# CRM_SSO_URL=

# ── Scrape tuning ───────────────────────────────────────────────────────────
# One store per instance, so concurrency here is tabs, not stores.
PHASE_WORKERS=5
RECHECK_TABS=5
SSO_WAIT_MS=15000
SSO_ATTEMPTS=3
NAV_TIMEOUT_MS=60000
LEAD_TIMEOUT_MS=180000
SEND_MESSAGES=false

# HEADLESS=true is more detectable; debug only.
# HEADLESS=false
